{
  "name": "stock-expiration-tracker",
  "version": "1.8.3",
  "description": "Desktop stock and expiration date tracker with LINE and Telegram alerts",
  "main": "out/main/index.js",
  "author": "PB Valley Stock",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:web": "tsc --noEmit -p web/tsconfig.json && vite build --config web/vite.config.ts && node scripts/build-web.mjs",
    "start:web": "node web-dist/server.cjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:mac": "npm run build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps",
    "line:id-helper": "node scripts/line-id-helper.mjs"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "exceljs": "^4.4.0",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@fontsource/kanit": "^5.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^44.2.0",
    "electron-builder": "^26.0.20",
    "electron-vite": "^5.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "build": {
    "appId": "com.pbvalley.stocktracker",
    "productName": "Stock Expiration Tracker",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "th"
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "logo-pb.png",
        "to": "logo-pb.png"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stock Expiration Tracker"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business"
    }
  }
}
